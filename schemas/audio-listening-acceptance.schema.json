{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://help-math.local/schemas/audio-listening-acceptance.schema.json",
  "title": "Authoritative audio listening acceptance",
  "type": "object",
  "required": ["schemaVersion", "evidenceType", "animationId", "status", "bindings", "cueReviews", "summary", "review"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": { "const": "authoritative-audio-listening-acceptance" },
    "animationId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "accepted", "rejected"] },
    "bindings": { "type": "object", "required": ["sourceSwf", "machineAudioAudit", "audioInventory"] },
    "cueReviews": { "type": "array", "minItems": 1 },
    "summary": { "type": "object", "required": ["everyCueListened", "everyReachableHostStateTraversed", "synchronizationAccepted", "replayAccepted"] },
    "review": {
      "type": "object",
      "required": ["decision", "reviewer", "attestation", "signedAt", "scope"],
      "properties": {
        "reviewer": {
          "type": "object",
          "required": ["kind", "fullName", "role", "organizationOrOwnerId", "contact"],
          "properties": {"kind": {"const": "human"}}
        }
      }
    }
  },
  "additionalProperties": false
}
