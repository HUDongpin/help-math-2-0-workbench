{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helpmath.ai/schemas/g678-factory-run-manifest-v2.json",
  "title": "HELP Math G6-G8 shared FactoryRunManifestV2",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestKind",
    "factory",
    "runId",
    "mode",
    "archiveReceiptGate",
    "archiveReceipts",
    "archiveReceiptVerification",
    "lane",
    "inputManifestSha256",
    "parserSha256",
    "assetSha256",
    "backendVersions",
    "irSchemaVersion",
    "generatorSha256",
    "adapterSha256",
    "stagingPath",
    "outputManifestSha256",
    "warnings",
    "failureCode",
    "elapsedMachineMs",
    "reworkOfRunId",
    "profile",
    "placementIds",
    "sourceAssetSha256",
    "sourceXmlSha256",
    "toolchain",
    "generator",
    "cache",
    "acceptanceEffects"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "manifestKind": {"const": "FactoryRunManifestV2"},
    "factory": {"const": "g678-shared-page-factory"},
    "runId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["calibrate", "extend"]},
    "archiveReceiptGate": {"enum": ["not-declared", "blocked-unverified", "hash-verified"]},
    "archiveReceipts": {"type": "array", "items": {"type": "object", "required": ["receiptId", "status", "verification"], "properties": {"key": {"type": "string", "minLength": 1}, "receiptId": {"type": "string", "minLength": 1}, "declaredPath": {"type": ["string", "null"]}, "containerPath": {"type": ["string", "null"]}, "memberManifestPath": {"type": ["string", "null"]}, "resolvedPath": {"type": ["string", "null"]}, "resolvedMemberPath": {"type": ["string", "null"]}, "declaredSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "containerSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "memberManifestSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "containerBytes": {"type": ["integer", "null"], "minimum": 1}, "disposition": {"type": ["string", "null"]}, "rehashRequiredAtRunStart": {"type": "boolean"}, "status": {"enum": ["declared-unverified", "verified"]}, "reason": {"type": ["string", "null"]}, "candidates": {"type": "array", "items": {"type": "string"}}, "identity": {"type": ["object", "null"]}, "memberManifestIdentity": {"type": ["object", "null"]}, "verification": {"enum": ["not-requested", "explicit-bounded-hash"]}}, "additionalProperties": true}},
    "archiveReceiptVerification": {"type": "object", "required": ["status", "maxBytes"], "properties": {"status": {"enum": ["not-requested", "explicit-bounded-hash"]}, "maxBytes": {"type": "integer", "minimum": 1}}, "additionalProperties": true},
    "lane": {"type": "string", "minLength": 1},
    "inputManifestSha256": {"$ref": "#/$defs/sha256"},
    "parserSha256": {"$ref": "#/$defs/sha256"},
    "assetSha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
    "backendVersions": {"type": "object"},
    "irSchemaVersion": {"type": "integer", "minimum": 1},
    "generatorSha256": {"$ref": "#/$defs/sha256"},
    "adapterSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "stagingPath": {"type": "string", "minLength": 1},
    "outputManifestSha256": {"$ref": "#/$defs/sha256"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "failureCode": {"type": ["string", "null"]},
    "elapsedMachineMs": {"type": "number", "minimum": 0},
    "reworkOfRunId": {"type": ["string", "null"]},
    "profile": {
      "type": "object",
      "required": ["path", "profileId", "version", "sha256", "sourceViewPath", "canonicalRoot"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "profileId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sourceViewPath": {"type": "string", "minLength": 1},
        "canonicalRoot": {"type": "string", "minLength": 1},
        "sourceManifestSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "mappingManifestSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "parserSha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    },
    "placementIds": {"type": "array", "items": {"type": "string", "pattern": "^shared-[a-z0-9]+-l[0-9]{2}-p[0-9]{3}$"}, "uniqueItems": true},
    "sourceAssetSha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
    "sourceXmlSha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
    "sourcePlacements": {"type": "array"},
    "sourceIdentity": {"type": "object"},
    "laneSummary": {"type": "object"},
    "toolchain": {"type": "object"},
    "generator": {
      "type": "object",
      "required": ["script", "sha256", "irSchemaVersion", "extractionInvoked", "runtimeInvoked"],
      "properties": {
        "script": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "irSchemaVersion": {"type": "integer", "minimum": 1},
        "extractionInvoked": {"const": false},
        "runtimeInvoked": {"const": false}
      },
      "additionalProperties": true
    },
    "launcherArgs": {"type": "array", "items": {"type": "string"}},
    "cache": {
      "type": "object",
      "required": ["cacheKey", "cacheSchemaVersion", "hit"],
      "properties": {
        "cacheKey": {"$ref": "#/$defs/sha256"},
        "cacheSchemaVersion": {"const": 1},
        "hit": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "staging": {"type": "object"},
    "acceptanceEffects": {
      "type": "object",
      "required": [
        "canonicalSourcePromoted",
        "sourceCustodyChanged",
        "modernCourseUiChanged",
        "modernMyLessonHostChanged",
        "legacyFlashCourseShellConverted",
        "currentJavaScriptRegistered",
        "avm1BehaviorCompiled",
        "nestedAudioPlaybackCompiled",
        "originalRuntimeAccepted",
        "behaviorAccepted",
        "visualFidelityAccepted",
        "audioAccepted",
        "humanVisualAccepted",
        "ownerAccepted",
        "strictComplete",
        "released",
        "published"
      ],
      "additionalProperties": {"const": false}
    },
    "failure": {"type": ["object", "null"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
