{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helpmath.ai/schemas/g678-factory-run-manifest-v2.json",
  "title": "HELP Math G6-G8 shared FactoryRunManifestV2",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestKind",
    "factory",
    "runId",
    "mode",
    "profile",
    "placementIds",
    "sourceAssetSha256",
    "sourceXmlSha256",
    "toolchain",
    "generator",
    "cache",
    "acceptanceEffects"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "manifestKind": {"const": "FactoryRunManifestV2"},
    "factory": {"const": "g678-shared-page-factory"},
    "runId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["calibrate", "extend"]},
    "profile": {
      "type": "object",
      "required": ["path", "profileId", "version", "sha256", "sourceViewPath", "canonicalRoot"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "profileId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sourceViewPath": {"type": "string", "minLength": 1},
        "canonicalRoot": {"type": "string", "minLength": 1},
        "sourceManifestSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "mappingManifestSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "additionalProperties": true
    },
    "placementIds": {"type": "array", "items": {"type": "string", "pattern": "^shared-[a-z0-9]+-l[0-9]{2}-p[0-9]{3}$"}, "uniqueItems": true},
    "sourceAssetSha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
    "sourceXmlSha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
    "sourcePlacements": {"type": "array"},
    "sourceIdentity": {"type": "object"},
    "laneSummary": {"type": "object"},
    "toolchain": {"type": "object"},
    "generator": {
      "type": "object",
      "required": ["script", "sha256", "irSchemaVersion", "extractionInvoked", "runtimeInvoked"],
      "properties": {
        "script": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "irSchemaVersion": {"type": "integer", "minimum": 1},
        "extractionInvoked": {"const": false},
        "runtimeInvoked": {"const": false}
      },
      "additionalProperties": true
    },
    "launcherArgs": {"type": "array", "items": {"type": "string"}},
    "cache": {
      "type": "object",
      "required": ["cacheKey", "cacheSchemaVersion", "hit"],
      "properties": {
        "cacheKey": {"$ref": "#/$defs/sha256"},
        "cacheSchemaVersion": {"const": 1},
        "hit": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "staging": {"type": "object"},
    "acceptanceEffects": {
      "type": "object",
      "required": [
        "canonicalSourcePromoted",
        "sourceCustodyChanged",
        "modernCourseUiChanged",
        "modernMyLessonHostChanged",
        "legacyFlashCourseShellConverted",
        "currentJavaScriptRegistered",
        "avm1BehaviorCompiled",
        "nestedAudioPlaybackCompiled",
        "originalRuntimeAccepted",
        "behaviorAccepted",
        "visualFidelityAccepted",
        "audioAccepted",
        "humanVisualAccepted",
        "ownerAccepted",
        "strictComplete",
        "released",
        "published"
      ],
      "additionalProperties": {"const": false}
    },
    "failure": {"type": ["object", "null"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
