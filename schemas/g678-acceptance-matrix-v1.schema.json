{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helpmath.ai/schemas/g678-acceptance-matrix-v1.schema.json",
  "title": "HELP Math G6-G8 shared acceptance funnel v1",
  "description": "Read-only source-bound funnel. It does not grant registration, acceptance, release, or publication authority.",
  "type": "object",
  "required": ["schemaVersion", "artifactType", "matrixId", "generatedAt", "source", "sourceAudit", "funnel", "lessons", "acceptanceEffects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "help-math-g678-acceptance-matrix"},
    "matrixId": {"type": "string", "pattern": "^g678-acceptance-matrix-v[0-9]+$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["catalogPath", "catalogSha256", "mappingPath", "mappingSha256", "releaseManifestPath", "releaseManifestSha256", "governancePath", "governanceSha256", "scope", "legacyCourseShellExcluded"],
      "properties": {
        "catalogPath": {"type": "string", "minLength": 1},
        "catalogSha256": {"$ref": "#/$defs/sha256"},
        "mappingPath": {"type": "string", "minLength": 1},
        "mappingSha256": {"$ref": "#/$defs/sha256"},
        "releaseManifestPath": {"type": ["string", "null"]},
        "releaseManifestSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "governancePath": {"type": ["string", "null"]},
        "governanceSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "scope": {"const": "canonical-active-page-only"},
        "legacyCourseShellExcluded": {"const": true}
      },
      "additionalProperties": false
    },
    "sourceAudit": {
      "type": "object",
      "required": ["canonicalLessonXmlCount", "activePagePlacementCount", "uniqueActiveSwfSha256Count", "commentedPageCount", "bomXmlCount", "bareAmpersandCount", "canonicalSwfCount", "canonicalMp3Count", "canonicalFlaCount", "missingSources", "unknownSwfMagic", "variantPlacements", "dependencyHolds", "audioCandidatePages", "acceptanceNeutral"],
      "properties": {
        "canonicalLessonXmlCount": {"const": 44},
        "activePagePlacementCount": {"const": 2282},
        "uniqueActiveSwfSha256Count": {"type": "integer", "minimum": 0},
        "commentedPageCount": {"type": "integer", "minimum": 0},
        "bomXmlCount": {"type": "integer", "minimum": 0},
        "bareAmpersandCount": {"type": "integer", "minimum": 0},
        "canonicalSwfCount": {"type": "integer", "minimum": 0},
        "canonicalMp3Count": {"type": "integer", "minimum": 0},
        "canonicalFlaCount": {"const": 0},
        "missingSources": {"type": "integer", "minimum": 0},
        "unknownSwfMagic": {"type": "integer", "minimum": 0},
        "variantPlacements": {"type": "integer", "minimum": 0},
        "dependencyHolds": {"type": "integer", "minimum": 0},
        "audioCandidatePages": {"type": "integer", "minimum": 0},
        "acceptanceNeutral": {"const": true}
      },
      "additionalProperties": false
    },
    "funnel": {
      "type": "object",
      "required": ["lessons", "activePagePlacements", "registeredCurrentJsPages", "engineeringPreviewLessons", "mappingApprovedLessons", "originalRuntimeEvidencePages", "fidelityAcceptedPages", "audioAcceptedPages", "humanVisualAcceptedLessons", "ownerAcceptedLessons", "strictCompleteLessons", "releasedLessons", "publishedLessons"],
      "properties": {
        "lessons": {"const": 44},
        "activePagePlacements": {"const": 2282},
        "registeredCurrentJsPages": {"type": "integer", "minimum": 0, "maximum": 2282},
        "engineeringPreviewLessons": {"type": "integer", "minimum": 0, "maximum": 44},
        "mappingApprovedLessons": {"type": "integer", "minimum": 0, "maximum": 44},
        "originalRuntimeEvidencePages": {"type": "integer", "minimum": 0, "maximum": 2282},
        "fidelityAcceptedPages": {"type": "integer", "minimum": 0, "maximum": 2282},
        "audioAcceptedPages": {"type": "integer", "minimum": 0, "maximum": 2282},
        "humanVisualAcceptedLessons": {"type": "integer", "minimum": 0, "maximum": 44},
        "ownerAcceptedLessons": {"type": "integer", "minimum": 0, "maximum": 44},
        "strictCompleteLessons": {"type": "integer", "minimum": 0, "maximum": 44},
        "releasedLessons": {"type": "integer", "minimum": 0, "maximum": 44},
        "publishedLessons": {"type": "integer", "minimum": 0, "maximum": 44}
      },
      "additionalProperties": false
    },
    "lessons": {"type": "array", "minItems": 44, "maxItems": 44, "items": {"$ref": "#/$defs/lesson"}},
    "acceptanceEffects": {
      "type": "object",
      "required": ["currentJavaScriptRegistered", "authoritativeOriginalRuntime", "visualFidelityAccepted", "audioAccepted", "humanVisualAccepted", "ownerAccepted", "strictComplete", "released", "published"],
      "properties": {
        "currentJavaScriptRegistered": {"const": false},
        "authoritativeOriginalRuntime": {"const": false},
        "visualFidelityAccepted": {"const": false},
        "audioAccepted": {"const": false},
        "humanVisualAccepted": {"const": false},
        "ownerAccepted": {"const": false},
        "strictComplete": {"const": false},
        "released": {"const": false},
        "published": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lesson": {
      "type": "object",
      "required": ["stableLessonKey", "moduleCode", "lessonNumber", "primaryGrade", "gradeTags", "mappingStatus", "activePageCount", "registeredPageCount", "availability", "acceptance"],
      "properties": {
        "stableLessonKey": {"type": "string", "pattern": "^shared-(nms002|geo001|alg001|dat001)-l[0-9]{2}$"},
        "moduleCode": {"enum": ["NMS002", "GEO001", "ALG001", "DAT001"]},
        "lessonNumber": {"type": "integer", "minimum": 1},
        "primaryGrade": {"type": ["integer", "null"], "enum": [6, 7, 8, null]},
        "gradeTags": {"type": "array", "items": {"enum": [6, 7, 8]}, "uniqueItems": true},
        "mappingStatus": {"enum": ["pending", "approved", "needs-adjudication", "rejected"]},
        "activePageCount": {"type": "integer", "minimum": 1},
        "registeredPageCount": {"type": "integer", "minimum": 0},
        "availability": {"enum": ["locked", "engineering-preview"]},
        "acceptance": {"type": "object", "additionalProperties": {"const": false}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
