{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://help-math.local/schemas/authorized-original-runtime-toolchain-receipt.schema.json",
  "title": "Authorized original-runtime toolchain receipt",
  "type": "object",
  "required": ["schemaVersion", "evidenceType", "runtime", "capturedAt", "identityArtifacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "evidenceType": {"const": "authorized-original-runtime-toolchain-receipt"},
    "runtime": {
      "type": "object",
      "required": ["runtimeId", "name", "version"],
      "properties": {
        "runtimeId": {"enum": ["adobe-animate-test-movie", "adobe-flash-player-projector", "adobe-flash-player-authorized-legacy-browser"]},
        "name": {"enum": ["Adobe Animate Test Movie", "Adobe Flash Player Projector", "Adobe Flash Player (Authorized Legacy Browser)"]},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "capturedAt": {"type": "string", "format": "date-time"},
    "identityArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "file", "sha256"],
        "properties": {
          "kind": {"enum": ["product-version-capture", "executable-sha256-receipt", "workstation-toolchain-log"]},
          "file": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
