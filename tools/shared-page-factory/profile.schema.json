{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helpmath.ai/schemas/g678-shared-source-profile-v1.json",
  "title": "G6-G8 shared source profile",
  "type": "object",
  "required": ["schemaVersion", "profileId", "version", "modules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profileId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "requireReadOnlySource": {"type": "boolean"},
    "sourceView": {
      "type": "object",
      "properties": {
        "rootEnv": {"type": "string", "minLength": 1},
        "relativeRoot": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "sourceViewPath": {"type": "string", "minLength": 1},
    "sourceRoot": {"type": "string", "minLength": 1},
    "canonicalRootRule": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object", "required": ["relativePath"], "properties": {"relativePath": {"type": "string", "minLength": 1}}}
      ]
    },
    "activePageCounts": {"type": "object"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["moduleCode"],
        "properties": {
          "moduleCode": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{2,15}$"},
          "moduleTitle": {"type": "string"},
          "sourceRoot": {"type": "string"},
          "lessonNumbers": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "expectedActivePageCount": {"type": "integer", "minimum": 0},
          "expectedActivePagesByLesson": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "moduleDefinitions": {"type": "array"},
    "calibrationSet": {"type": "array", "minItems": 1},
    "toolchain": {"type": "object"},
    "licenseManifest": {}
  },
  "additionalProperties": true
}
