NEXT_PUBLIC_SITE_URL=https://www.helpmath.ai
# Local-only Clerk development candidate. Production always fails closed even
# if this flag is accidentally copied. Provider initialization additionally
# requires both ignored Clerk development keys and a canonical loopback origin.
# Keyless bootstrap is deliberately unsupported: registration tests must not
# put a provider secret in client-readable browser state.
CLERK_LOCAL_AUTH_ENABLED=false
CLERK_LOCAL_AUTH_ORIGIN=http://127.0.0.1:3211
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account
CURRENT_JS_SHOWCASE_G4_L3_ENABLED=false
CURRENT_JS_SHOWCASE_G5_L4_ENABLED=false
CURRENT_JS_SHOWCASE_G3_L2_ENABLED=false
CURRENT_JS_SHOWCASE_G5_L3_ENABLED=false
CURRENT_JS_SHOWCASE_G5_L5_ENABLED=false
# Independent server-only opt-in; the animation showcase flag does not publish audio.
CURRENT_JS_SHOWCASE_G5_L4_AUDIO_ENABLED=false
MODERN_WIDE_SHELL_ENABLED=false
NOVA_TUTOR_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
NOVA_MODEL=openai/gpt-5.6-luna
NOVA_TIMEOUT_MS=45000
NOVA_MAX_OUTPUT_TOKENS=700
NOVA_ALLOW_FRAME_CONTEXT=false
NOVA_TUTOR_RATE_LIMIT_PER_MINUTE=12
LRS_ENABLED=false
LRS_ENDPOINT=
LRS_USERNAME=
LRS_PASSWORD=
LRS_XAPI_VERSION=1.0.3
LRS_ACTOR_HMAC_SECRET=
LRS_REQUEST_TIMEOUT_MS=7000
LRS_RATE_LIMIT_PER_MINUTE=120
CONTACT_FORM_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Optional synthetic integration transport. `mailpit-local` is rejected in
# production, uses the fixed 127.0.0.1:1025 endpoint without auth/TLS, and
# accepts only exact normalized local-part@helpmath.invalid recipients. Unknown
# values and a missing selection fail closed. `resend` must be selected
# explicitly and is rejected by the synthetic-invalid-only recipient profile.
FAMILY_EMAIL_TRANSPORT=resend
SUPPORT_TO_EMAIL=support@helpmath.ai
SUPPORT_FROM_EMAIL=HELP Math <support@helpmath.ai>

# Family Portal is deny-by-default. The synthetic flag is ignored in production.
FAMILY_PORTAL_ENABLED=false
FAMILY_MESSAGING_ENABLED=false
FAMILY_EMAIL_NOTIFICATIONS_ENABLED=false
FAMILY_SYNTHETIC_DEMO_ENABLED=false
# Server-only Phase-1 gate for signed-in learner assignment events. It is
# ignored in production, and SQL independently requires an enabled synthetic
# tenant. It is unrelated to the legacy pseudonymous LRS_ENABLED switch.
FAMILY_LEARNING_EVENTS_V2_ENABLED=false
# Exactly one authentication authority may be active. `clerk-development`
# remains a loopback-only candidate; production Family access requires the
# separately approved `supabase` cutover. Incomplete requested configuration
# fails closed and never falls back to another provider.
FAMILY_AUTH_PROVIDER=disabled
FAMILY_SUPABASE_AUTH_CUTOVER_ENABLED=false
# Must exactly equal the selected project's `https://<ref>.supabase.co/auth/v1`
# issuer and the audience verified in each access token.
FAMILY_SUPABASE_AUTH_ISSUER=
FAMILY_SUPABASE_AUTH_AUDIENCE=authenticated
# Supabase request traffic uses the publishable key plus the signed-in provider
# token so RLS remains authoritative. The service-role key is reserved for the
# authorized notification cron worker and never enters a public request path.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Short-lived server-only JWT with role=family_webhook_writer. That database
# role has no table privileges and can execute only the delivery-event RPC.
# Provision and rotate it through the reviewed environment workflow; never
# expose it through NEXT_PUBLIC_*, logs, source control, or browser state.
FAMILY_WEBHOOK_WRITER_JWT=
FAMILY_WEBHOOK_WRITER_JWT_ISSUER=
FAMILY_WEBHOOK_WRITER_JWT_AUDIENCE=authenticated
# Externally provisioned ES256 token with role/sub=family_invitation_issuer and
# family_purpose=family_invitation_issue_v1. Its total lifetime is at most five
# minutes. The app holds no project signing private key and never exposes this
# bearer through NEXT_PUBLIC_*, logs, source control, or browser state.
FAMILY_INVITATION_ISSUER_JWT=
FAMILY_INVITATION_ISSUER_JWT_ISSUER=
FAMILY_INVITATION_ISSUER_JWT_AUDIENCE=authenticated
# Invitation recipients default to disabled. Local integration may use only
# `synthetic-invalid-only`, which accepts exact local-part@helpmath.invalid
# addresses and the loopback Mailpit transport. A reviewed production cutover
# may use `school-verified-production` only with NODE_ENV=production, Supabase
# Auth, explicit Resend transport, the dedicated least-privilege issuer, active
# approved retention policies, and the separate enablement below. Its exact
# production `tenant_identity_issuers` row must also set
# `requires_database_session=true`, binding requests and invitation terminal
# transitions to a live Supabase `auth.sessions` row. The server rejects
# reserved test domains and never trusts this setting by itself.
FAMILY_INVITATION_RECIPIENT_POLICY=disabled
FAMILY_PRODUCTION_INVITATIONS_ENABLED=false
# Versioned AES-256-GCM keyring JSON, for example {"k2026_08":"<base64url>"}.
# Each value is 32 random bytes encoded canonically with base64url. New writes
# use only ACTIVE_KEY_ID; reads select the envelope kid so an old and new key can
# overlap during rotation. Token and email subkeys/AAD are purpose-, tenant-,
# and record-bound. Never expose any keyring variable to client code.
FAMILY_OUTBOX_ENCRYPTION_KEYRING=
FAMILY_OUTBOX_ENCRYPTION_ACTIVE_KEY_ID=
# v1 is read-only and disabled by default. Set both variables only during a
# reviewed, time-bounded drain/re-encryption; v1 writes are never supported.
FAMILY_OUTBOX_LEGACY_V1_READ_ENABLED=false
FAMILY_OUTBOX_LEGACY_V1_READ_KEY=
# A different 32-byte base64url key for keyed adult-email digests. Do not reuse
# the encryption key; rotate only through a reviewed dual-read migration.
FAMILY_EMAIL_DIGEST_KEY=
FAMILY_FROM_EMAIL=HELP Math Family <family@helpmath.ai>
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
# Release-tooling trust anchor only; this is a public SHA-256 digest, not a key.
# It must be injected by an independently controlled release environment and
# must match the exact external Ed25519 trust-root JSON supplied to
# `npm run verify:family:real-release-receipt`. It is not used by web runtime.
FAMILY_REAL_RELEASE_TRUST_ROOTS_SHA256=
