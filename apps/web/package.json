{
  "name": "@helpmath/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:preflight": "tsx scripts/check-clerk-local-auth-preflight.ts",
    "auth:provider-preflight": "tsx scripts/check-clerk-synthetic-provider-preflight.ts",
    "auth:test:synthetic": "tsx scripts/run-clerk-synthetic-registration.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "MODERN_WIDE_SHELL_ENABLED=false CURRENT_JS_SHOWCASE_G4_L3_ENABLED=true CURRENT_JS_SHOWCASE_G5_L4_ENABLED=true CURRENT_JS_SHOWCASE_G5_L4_AUDIO_ENABLED=true playwright test",
    "test:e2e:g5-l4-audio-gate-off": "PLAYWRIGHT_PORT=3212 MODERN_WIDE_SHELL_ENABLED=false CURRENT_JS_SHOWCASE_G5_L4_ENABLED=true CURRENT_JS_SHOWCASE_G5_L4_AUDIO_ENABLED=false playwright test g5-l4-audio.spec.ts --grep 'gate-off direct FQ route exposes unavailable disabled audio only'",
    "test:e2e:modern-wide": "MODERN_WIDE_SHELL_ENABLED=true CURRENT_JS_SHOWCASE_G4_L3_ENABLED=true CURRENT_JS_SHOWCASE_G5_L4_ENABLED=true CURRENT_JS_SHOWCASE_G5_L4_AUDIO_ENABLED=true playwright test prototype-acceptance.spec.ts modern-wide-geometry.spec.ts canvas-sharpness.spec.ts learning-experience-polish.spec.ts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.15.2",
    "@clerk/nextjs": "^7.7.5",
    "@clerk/shared": "^4.29.0",
    "@helpmath/demos": "*",
    "@marsidev/react-turnstile": "^1.5.3",
    "@vercel/analytics": "^2.0.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.25.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/backend": "^3.16.5",
    "@clerk/testing": "^2.2.23",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3"
  }
}
