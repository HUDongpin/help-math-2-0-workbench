# The deployable application is apps/web in this npm monorepo. Its reviewed
# inputs under catalog/ and packages/demos/ must remain available to the build.
# These exclusions are a second line of defense for Vercel CLI uploads. The hard
# boundary is keeping legacy evidence in a separate private archive repository.
HELP MATH_ORIGINAL FILES/
/HELP MATH_ORIGINAL FILES
source-assets/
public/flash/
public/flash-assets/
public/ruffle/
**/*.fla
**/*.swf

# Forensic evidence, migration workspaces, and the legacy workbench are not part
# of the public website deployment.
artifacts/
migrations/
templates/
output/
outputs/
documentation/
work/
private-archive/
/app/
/apps/site/
reports/*
!reports/g5-l4-source-scope-freeze.json
!reports/g3-l2-cross-grade-factory-audit.json
!reports/g5-l3-page-only-whole-lesson-source-scope.json

# The web runtime reads only this exact catalog closure. Historical catalog
# variants, promotion plans, CSV/JSONL exports, and workbench ledgers remain in
# the repository but are not deployment inputs.
catalog/**
!catalog/animations.json
!catalog/completion-ledger.json
!catalog/lesson-release-ledger.json
!catalog/lesson-releases.json
!catalog/lessons.json
!catalog/missing-references.json
!catalog/page-only-current-js-product-releases.json

# Local secrets and owner-provided credential documents must never enter a
# deployment upload, even when a future CLI version changes ignore precedence.
All API Keys.docx
.env
.env.*
**/.env
**/.env.*

# Fail closed on local linked worktrees and machine/security configuration.
# These exact rules remain mandatory even when the paths are absent from the
# current release tree, because both appeared in an earlier candidate commit.
.codex-validation-*
**/.codex-validation-*
pkcs11.txt
**/pkcs11.txt
**/.cache/
/.launch-control-runtime/

# Local Next.js output variants are reproducible build caches, not deployment
# inputs. Public visual runtimes remain under apps/web/public/; exact G5 L4
# audio remains deployable under apps/web/server-assets/ and is included only
# in the protected route's output trace.
apps/web/.next*/
apps/web/candidate-assets/
candidate-evidence/

# Test and browser-automation sources stay in Git and CI. The production build
# deliberately reruns one exact production asset-profile verification closure,
# so retain only those two tests and keep every other test source out of the
# upload. Candidate runtime and evidence verification remains a local/CI gate.
apps/web/tests/*
!apps/web/tests/private-preview-deployment-assets.test.ts
!apps/web/tests/current-js-showcase-publication.test.ts
apps/web/e2e/
apps/web/playwright*.ts
apps/web/tsconfig.tsbuildinfo
packages/demos/test/
packages/demos/tests/
test-results/

# Repository-only operating material.
.agents/
.claude/
.playwright-cli/
.catalog.*
.github/
docs/
design/
skills/
scripts/*
!scripts/manage-current-js-asset-profiles.mjs
!scripts/current-js-candidate-paths.mjs
tools/
schemas/
native/
AGENTS.md
FILE_MANIFEST.sha256
PROJECT_MEMORY.md
README.md
*.docx
*.pdf
*.plist
20260808_Claude_Suggestions on UI of HELP MATH 2.0.md
help-math-modernization-recovery-audit-ai-roadmap.md
