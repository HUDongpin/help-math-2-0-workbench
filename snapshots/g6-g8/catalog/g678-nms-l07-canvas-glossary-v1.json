              "sha256": "3b437b42e75536fa8b4f110325e366c27fbe10a871439d4797650cda4238b407"
            }
          }
        },
        {
          "id": "equation",
          "sourceKeyAttribute": "Equation",
          "labels": {
            "en": "Equation",
            "es": "Ecuación"
          },
          "definitions": {
            "en": "A mathematical sentence where both sides of the equal sign (=) have the same value (are equal). For example: 9 + 9 = 3 x 6.",
            "es": "Enunciado de una igualdad en la cual ambos lados del signo igual (=) tienen el mismo valor (son iguales). Por ejemplo: 9 + 9 = 3 x 6."
          },
          "source": {
            "en": {
              "assetId": "G678L1KTE01.xml",
              "path": "HELP_KEYTERMS/KT/XML/L1KTE01.xml",
              "sha256": "14d454f4c1c1a6f0939fb80b454fd3e22890eabb4a730c6bfa7efa1d9a2e5e5b"
            },
            "es": {
              "assetId": "G678L1KTS01.xml",
              "path": "HELP_KEYTERMS/KT/XML/L1KTS01.xml",
              "sha256": "3b437b42e75536fa8b4f110325e366c27fbe10a871439d4797650cda4238b407"
            }
          }
        },
        {
          "id": "equivalent",
          "sourceKeyAttribute": "Equivalent",
          "labels": {
            "en": "Equivalent",
            "es": "Equivalente"
          },
          "definitions": {
            "en": "Having the same value or equaling the same amount. For example: when two expressions, such as 5/4 and 1 1/4, equal the same quantity, we say that the quantities are equivalent.",
            "es": "Que tienen el mismo valor o comparten la misma cantidad. Por ejemplo: cuando dos expresiones, como 5/4 y 1 1/4, tienen el mismo valor, decimos que son equivalentes."
          },
          "source": {
            "en": {
              "assetId": "G678L1KTE01.xml",
              "path": "HELP_KEYTERMS/KT/XML/L1KTE01.xml",
              "sha256": "14d454f4c1c1a6f0939fb80b454fd3e22890eabb4a730c6bfa7efa1d9a2e5e5b"
            },
            "es": {
              "assetId": "G678L1KTS01.xml",
              "path": "HELP_KEYTERMS/KT/XML/L1KTS01.xml",
              "sha256": "3b437b42e75536fa8b4f110325e366c27fbe10a871439d4797650cda4238b407"
            }
          }
        },
        {
          "id": "proportion",
          "sourceKeyAttribute": "Proportion",
          "labels": {
            "en": "Proportion",
            "es": "Proporción"
          },
          "definitions": {
            "en": "It is a mathematical sentence that states two ratios are equal.",
            "es": "Es un enunciado matemático que establece que dos razones son iguales."
          },
          "source": {
            "en": {
              "assetId": "G678L1KTE01.xml",
              "path": "HELP_KEYTERMS/KT/XML/L1KTE01.xml",
              "sha256": "14d454f4c1c1a6f0939fb80b454fd3e22890eabb4a730c6bfa7efa1d9a2e5e5b"
            },
            "es": {
