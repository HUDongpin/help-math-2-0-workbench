              "sha256": "3b437b42e75536fa8b4f110325e366c27fbe10a871439d4797650cda4238b407"
            }
          }
        },
        {
          "id": "ratio",
          "sourceKeyAttribute": "Ratio",
          "labels": {
            "en": "Ratio",
            "es": "Razón"
          },
          "definitions": {
            "en": "A ratio is a comparison of the quantity or measure of two different things. A ratio can be written as a fraction, with a colon, or with the word “to”. For example: ¾ is a ratio which shows how many yellow blocks there are to blue blocks, which can also be shown as 3:4 or 3 to 4.",
            "es": "Es la comparación de la cantidad y medida de objetos diferentes. Una razón se puede escribir como una fracción, con dos puntos, o con la palabra “a”. Por ejemplo: 3/4 es una proporción en la que se muestra cuantos bloques amarillos hay con respecto a bloques azules, lo que también se puede mostrar como 3 : 4 o \"tres a cuatro\"."
          },
          "source": {
            "en": {
              "assetId": "G678L1KTE01.xml",
              "path": "HELP_KEYTERMS/KT/XML/L1KTE01.xml",
              "sha256": "14d454f4c1c1a6f0939fb80b454fd3e22890eabb4a730c6bfa7efa1d9a2e5e5b"
