      "sourceKeyAttribute": "Simplest Form",
      "labels": {
        "en": "Simplest Form",
        "es": "Forma más simple"
      },
      "definitions": {
        "en": "To show something in its easiest form to understand. For example: the simplest form of the fraction 8/32 is 1/4, that is 4/16 = 2/8 = 1/4.",
        "es": "Es poner algo en su forma más fácil de entender. Por ejemplo: la forma más simple de la fracción 8/32 es 1/4, a la que se llega por la simplificación 4/16 = 2/8 = 1/4."
      },
