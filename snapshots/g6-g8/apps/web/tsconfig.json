{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@helpmath/demos/animation-registry": [
        "../../packages/demos/src/animation-registry.ts"
      ],
      "@helpmath/demos/animation-registry-metadata": [
        "../../packages/demos/src/animation-registry-metadata.ts"
      ],
      "@helpmath/demos/local-only-animation-registry": [
        "../../packages/demos/src/local-only-animation-registry.ts"
      ],
      "@helpmath/demos/local-only-animation-registry-metadata": [
        "../../packages/demos/src/local-only-animation-registry-metadata.ts"
      ],
      "@helpmath/demos/nms-l02-p064-local-candidate": [
        "../../packages/demos/src/nms-l02-p064-quiz-candidate.tsx"
      ],
      "@helpmath/demos/alg-l06-p001-local-candidate": [
        "../../packages/demos/src/alg-l06-p001-title-view.tsx"
      ],
      "@helpmath/demos/nms-l02-p054-local-candidate": [
        "../../packages/demos/src/nms-l02-p054-board-candidate.tsx"
      ],
      "@helpmath/demos/geo-l06-p002-local-candidate": [
        "../../packages/demos/src/geo-l06-p002-local-candidate.tsx"
      ],
      "@helpmath/demos/geo-l07-p003-local-candidate": [
        "../../packages/demos/src/geo-l07-p003-candidate-renderer-v1.tsx"
      ],
      "@helpmath/demos/dat-l02-p002-local-candidate": [
        "../../packages/demos/src/dat-l02-p002-candidate-renderer-v1.tsx"
      ],
      "@helpmath/demos/prototype-manifest": [
        "../../packages/demos/src/prototype-manifest.ts"
      ],
      "@helpmath/demos/runtime": [
        "../../packages/demos/src/runtime.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-alg-p001-local-qa/types/**/*.ts",
    ".next-alg-p001-local-qa/dev/types/**/*.ts",
    ".next-alg-l10-p004-local-qa-20261008-v1/types/**/*.ts",
    ".next-alg-l10-p004-local-qa-20261008-v1/dev/types/**/*.ts",
    ".next-g678-hfr-local-qa-20261011-v1/types/**/*.ts",
    ".next-g678-hfr-local-qa-20261011-v1/dev/types/**/*.ts",
    ".next-g678-compiled-local-qa/types/**/*.ts",
    ".next-g678-compiled-local-qa/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
