  "question": {
    "textId": 144,
    "text": "The graph shows the efficiency of a machine as a function of the amount of time the machine has been running. Time is measured in hours. Choose the statement that best describes the efficiency of the machine after 1 hour?",
    "firstFrame": 2,
    "lastFrame": 327
  },
  "helpText": [
    {
      "textId": 133,
      "text": "Separate the graph into sections."
    },
    {
      "textId": 134,
      "text": "Identify the lowest point. Then identify the highest point."
    },
    {
      "textId": 138,
      "text": "Between the highest and lowest point, the efficiency is rising."
    },
    {
      "textId": 135,
      "text": "After the highest point, the efficiency is falling."
    }
  ],
