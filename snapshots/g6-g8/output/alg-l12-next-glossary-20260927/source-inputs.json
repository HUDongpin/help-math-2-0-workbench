      "glossary": [
        {
          "id": "coordinate-plane",
          "sourceKeyAttribute": "Coordinate plane",
          "labels": {
            "en": "Coordinate plane",
            "es": "Plano de coordenadas"
          },
          "definitions": {
            "en": "A coordinate plane is a grid on which any point can be identified by an ordered pair of numbers or coordinates. The coordinate plane is represented by two perpendicular number lines: the horizontal x-axis and the vertical y-axis; also called the Cartesian plane or the Cartesian coordinate system.",
            "es": "Un plano de coordenadas es una cuadrícula en la que cada punto puede ser identificado por un par ordenado de números o coordenadas. El plano de coordenadas se representa por dos rectas graduadas y perpendiculares: el eje horizontal x y el eje vertical y; también llamado plano cartesiano o sistema cartesiano."
          },
          "source": {
            "en": {
              "assetId": "G678L1KTE01.xml",
              "path": "HELP_KEYTERMS/KT/XML/L1KTE01.xml",
              "sha256": "14d454f4c1c1a6f0939fb80b454fd3e22890eabb4a730c6bfa7efa1d9a2e5e5b"
