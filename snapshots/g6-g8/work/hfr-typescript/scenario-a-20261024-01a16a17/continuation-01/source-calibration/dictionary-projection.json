      {
        "id": "quantity",
        "sourceKeyAttribute": "Quantity",
        "labels": {
          "en": "Quantity",
          "es": "Cantidad"
        },
        "definitions": {
          "en": "A measure or number of something. For example: there are three flowers in the picture. We could say that “the quantity of flowers is three.”",
          "es": "La medida o expresión numèrica de algo. Por ejemplo: hay tres flores en el dibujo. Podríamos decir: “la cantidad de flores es tres”."
        },
        "source": {
