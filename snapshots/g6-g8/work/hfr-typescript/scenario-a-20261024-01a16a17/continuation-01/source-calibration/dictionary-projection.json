        "id": "cross-multiplication",
        "sourceKeyAttribute": "Cross multiplication",
        "labels": {
          "en": "Cross multiplication",
          "es": "Multiplicación cruzada"
        },
        "definitions": {
          "en": "To multiply the numerator of each fraction by the denominator of the other fraction in a proportion. Cross Multiplication is a “short cut” to using inverse operations.",
          "es": "Es multiplicar el numerador de cada fracción por el denominador de la otra. La multiplicación cruzada es una manera “corta” de usar operaciones inversas."
        },
        "source": {
