        "id": "comparison",
        "sourceKeyAttribute": "Comparison",
        "labels": {
          "en": "Comparison",
          "es": "Comparación"
        },
        "definitions": {
          "en": "To examine two or more items to find the similarities and differences between them.",
          "es": "Examinar dos o más objetos para encontrar las similitudes y diferencias entre ellos."
