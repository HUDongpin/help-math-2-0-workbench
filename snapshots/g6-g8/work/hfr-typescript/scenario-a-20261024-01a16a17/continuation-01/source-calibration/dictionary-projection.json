      {
        "id": "equivalent",
        "sourceKeyAttribute": "Equivalent",
        "labels": {
          "en": "Equivalent",
          "es": "Equivalente"
        },
        "definitions": {
          "en": "Having the same value or equaling the same amount. For example: when two expressions, such as 5/4 and 1 1/4, equal the same quantity, we say that the quantities are equivalent.",
          "es": "Que tienen el mismo valor o comparten la misma cantidad. Por ejemplo: cuando dos expresiones, como 5/4 y 1 1/4, tienen el mismo valor, decimos que son equivalentes."
        },
