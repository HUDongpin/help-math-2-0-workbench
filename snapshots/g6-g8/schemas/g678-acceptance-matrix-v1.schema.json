    "calibration": {
      "type": "object",
      "required": ["calibrationId", "frozenCalibrationPlacementCount", "sharedGeneratedCandidatePages", "advancedGeneratedCandidatePages", "pureLinearScaleoutPages", "fq01FamilyPages", "ts03L1GlossaryPages", "ts03L1ProductHostCalibratedPages", "ts03L1FamilyProductHostCalibrationPassed", "ts02L1GlossaryPages", "ts02L1ProductHostCalibratedPages", "ts02L1FamilyProductHostCalibrationPassed", "ts04L1GlossaryPages", "ts04L1ProductHostCalibratedPages", "ts04L1FamilyProductHostCalibrationPassed", "ts05L1GlossaryPages", "ts05L1ProductHostCalibratedPages", "ts05L1FamilyProductHostCalibrationPassed", "ts07AssessmentPages", "ts07ProductHostCalibratedPages", "ts07FamilyProductHostCalibrationPassed", "in02L1GlossaryPages", "in02L1ProductHostCalibratedPages", "in02L1FamilyProductHostCalibrationPassed", "in02SourceFrameBoundGlossaryControls", "in02SourceCharacterIdentityBound", "totalProductHostCalibratedPages", "registeredCurrentJsPages", "localPagePreviews", "wholeLessonEngineeringPreviews", "advancedRegisteredPages", "scaleOutAuthorized", "productCalibrationPassed"],
      "properties": {
        "calibrationId": {"const": "g678-16-page-product-calibration-v1"},
        "frozenCalibrationPlacementCount": {"const": 2282},
        "sharedGeneratedCandidatePages": {"const": 13},
        "advancedGeneratedCandidatePages": {"const": 3},
        "pureLinearScaleoutPages": {"const": 156},
        "fq01FamilyPages": {"const": 44},
        "ts03L1GlossaryPages": {"const": 15},
        "ts03L1ProductHostCalibratedPages": {"const": 15},
        "ts03L1FamilyProductHostCalibrationPassed": {"const": true},
        "ts02L1GlossaryPages": {"const": 15},
        "ts02L1ProductHostCalibratedPages": {"const": 15},
        "ts02L1FamilyProductHostCalibrationPassed": {"const": true},
        "ts04L1GlossaryPages": {"const": 15},
        "ts04L1ProductHostCalibratedPages": {"const": 15},
        "ts04L1FamilyProductHostCalibrationPassed": {"const": true},
        "ts05L1GlossaryPages": {"const": 15},
        "ts05L1ProductHostCalibratedPages": {"const": 15},
        "ts05L1FamilyProductHostCalibrationPassed": {"const": true},
        "ts07AssessmentPages": {"const": 1},
        "ts07ProductHostCalibratedPages": {"const": 1},
        "ts07FamilyProductHostCalibrationPassed": {"const": true},
        "in02L1GlossaryPages": {"const": 13},
        "in02L1ProductHostCalibratedPages": {"const": 13},
        "in02L1FamilyProductHostCalibrationPassed": {"const": true},
        "in02SourceFrameBoundGlossaryControls": {"const": true},
        "in02SourceCharacterIdentityBound": {"const": true},
        "totalProductHostCalibratedPages": {"const": 74},
        "registeredCurrentJsPages": {"const": 290},
        "localPagePreviews": {"const": 290},
        "wholeLessonEngineeringPreviews": {"const": 0},
        "advancedRegisteredPages": {"const": 3},
        "scaleOutAuthorized": {"const": false},
        "productCalibrationPassed": {"const": false}
      },
      "additionalProperties": false
    },
    "sourceAudit": {
      "type": "object",
      "required": ["canonicalLessonXmlCount", "activePagePlacementCount", "uniqueActiveSwfSha256Count", "commentedPageCount", "bomXmlCount", "bareAmpersandCount", "canonicalSwfCount", "canonicalMp3Count", "canonicalFlaCount", "missingSources", "unknownSwfMagic", "variantPlacements", "dependencyHolds", "audioCandidatePages", "audioGroupedCandidateCount", "geoAlternateLessonCount", "geoAlternateActivePageCount", "acceptanceNeutral"],
      "properties": {
        "canonicalLessonXmlCount": {"const": 44},
        "activePagePlacementCount": {"const": 2282},
        "uniqueActiveSwfSha256Count": {"type": "integer", "minimum": 0},
        "commentedPageCount": {"type": "integer", "minimum": 0},
        "bomXmlCount": {"type": "integer", "minimum": 0},
        "bareAmpersandCount": {"type": "integer", "minimum": 0},
        "canonicalSwfCount": {"type": "integer", "minimum": 0},
        "canonicalMp3Count": {"type": "integer", "minimum": 0},
        "canonicalFlaCount": {"const": 0},
        "missingSources": {"type": "integer", "minimum": 0},
        "unknownSwfMagic": {"type": "integer", "minimum": 0},
        "variantPlacements": {"type": "integer", "minimum": 0},
        "dependencyHolds": {"type": "integer", "minimum": 0},
        "audioCandidatePages": {"type": "integer", "minimum": 0},
        "audioGroupedCandidateCount": {"type": "integer", "minimum": 0},
        "geoAlternateLessonCount": {"type": "integer", "minimum": 0},
        "geoAlternateActivePageCount": {"type": "integer", "minimum": 0},
        "acceptanceNeutral": {"const": true}
      },
      "additionalProperties": false
