        "predecessorReportSha256": {"$ref": "#/$defs/sha256"},
        "browserEvidencePath": {"type": "string", "minLength": 1},
        "browserEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "reportBuilderPath": {"type": "string", "minLength": 1},
        "reportBuilderSha256": {"$ref": "#/$defs/sha256"},
        "scope": {"enum": ["canonical-active-page-only", "canonical-active-page-only-with-private-local-calibration"]},
        "legacyCourseShellExcluded": {"const": true}
