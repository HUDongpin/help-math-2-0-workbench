        "mappingSha256": {"$ref": "#/$defs/sha256"},
        "releaseManifestPath": {"type": ["string", "null"]},
        "releaseManifestSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "governancePath": {"type": ["string", "null"]},
        "governanceSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "calibrationFreezePath": {"type": "string", "minLength": 1},
