        "ts03FamilyCalibrationPath": {"type": "string", "minLength": 1},
        "ts03FamilyCalibrationSha256": {"$ref": "#/$defs/sha256"},
        "ts02FamilyCalibrationPath": {"type": "string", "minLength": 1},
        "ts02FamilyCalibrationSha256": {"$ref": "#/$defs/sha256"},
        "ts04FamilyCalibrationPath": {"type": "string", "minLength": 1},
        "ts04FamilyCalibrationSha256": {"$ref": "#/$defs/sha256"},
        "ts05FamilyCalibrationPath": {"type": "string", "minLength": 1},
        "ts05FamilyCalibrationSha256": {"$ref": "#/$defs/sha256"},
        "ts07FamilyCalibrationPath": {"type": "string", "minLength": 1},
        "ts07FamilyCalibrationSha256": {"$ref": "#/$defs/sha256"},
        "in02FamilyCalibrationPath": {"type": "string", "minLength": 1},
        "in02FamilyCalibrationSha256": {"$ref": "#/$defs/sha256"},
